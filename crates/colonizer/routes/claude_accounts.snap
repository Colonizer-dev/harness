/api/claude-accounts                                 GET    unauth=401    token=owner            activity=-
/api/claude-accounts                                 POST   unauth=401    token=owner            activity=settings.save
/api/claude-accounts/{id}                            DELETE unauth=401    token=owner            activity=settings.remove
/api/settings/claude-token                           DELETE unauth=401    token=owner            activity=settings.remove
/api/settings/claude-token                           POST   unauth=401    token=owner            activity=settings.save
