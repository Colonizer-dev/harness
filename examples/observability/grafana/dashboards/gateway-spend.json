{
  "schemaVersion": 39,
  "tags": [
    "colonizer"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "weekStart": "",
  "version": 1,
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Gateway requests/s by provider and outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (provider, outcome) (rate(colonizer_gateway_requests_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Fallbacks/s by provider",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (provider) (rate(colonizer_gateway_fallbacks_total[5m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Failure share (15m)",
      "description": "ok is requests minus failures; this panel divides error by all requests.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum(rate(colonizer_gateway_requests_total{outcome=\"error\"}[15m])) / clamp_min(sum(rate(colonizer_gateway_requests_total[15m])), 0.000000001)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "In flight by provider",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (provider) (colonizer_gateway_in_flight)",
          "instant": true,
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Waiting for a provider slot",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (provider) (colonizer_gateway_queued)",
          "instant": true,
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Request latency by provider",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le, provider) (rate(colonizer_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{provider}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(colonizer_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{provider}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Tokens/s by type (model=\"all\")",
      "description": "The model=\"all\" shape; do not stack with the per-model panel.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (type) (rate(colonizer_tokens_total{model=\"all\"}[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Tokens/s by model (type=\"total\")",
      "description": "The per-model shape; do not stack with the model=\"all\" panel.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (model) (rate(colonizer_tokens_total{type=\"total\"}[5m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Spend $/h by org",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (org) (rate(colonizer_cost_usd_total[5m])) * 3600",
          "legendFormat": "{{org}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Spend $/h by model",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum by (model) (rate(colonizer_cost_usd_total[5m])) * 3600",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Spend, last 24h",
      "description": "Models nothing has priced yet have no series, so this is a floor.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "colonizer-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "colonizer-prom"
          },
          "expr": "sum(increase(colonizer_cost_usd_total[24h]))",
          "legendFormat": "",
