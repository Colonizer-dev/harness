        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "title": "Colonizer — Gateway & spend",
  "uid": "colonizer-gateway",
  "description": "What the gateway costs: requests, failures and fallbacks per provider, latency, and tokens and dollars by org and model. The model=\"all\" and per-model token shapes must never be summed together."
