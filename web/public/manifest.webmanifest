{
  "name": "Colonizer",
  "short_name": "Colonizer",
  "description": "Colonize your backlog: the cockpit for your colonies.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#08080a",
  "theme_color": "#08080a",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/icons/screenshot-wide.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The Overview: dashboards for every workspace's colonies, costs and lead time"
    },
    {
      "src": "/icons/screenshot-narrow.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The Nest on a phone: every colony as a chamber, the ones that need you lit up"
    }
  ],
  "shortcuts": [
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "description": "What needs me: the colonies waiting on an answer",
      "url": "/?view=inbox",
      "icons": [{ "src": "/icons/shortcut-inbox.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Colonize",
      "short_name": "Colonize",
      "description": "Launch: send a colony out to settle an issue",
      "url": "/?view=launch",
      "icons": [{ "src": "/icons/shortcut-launch.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Nest",
      "short_name": "Nest",
      "description": "The nest: every colony at a glance",
      "url": "/?view=home",
      "icons": [{ "src": "/icons/shortcut-home.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
